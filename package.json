{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "reasonsmith",
  "description": "Reasonsmith, re-implemented in Effect TS (beta 4) and OpenTUI TS \u2014 an evidence-ladder conformance assessor, following the nikcli packages/* monorepo architecture",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "typecheck": "bun turbo typecheck",
    "test": "bun turbo test",
    "dev": "bun scripts/dev.ts",
    "dev:cli": "bun run --cwd packages/cli run",
    "dev:tui": "bun run --cwd packages/tui dev",
    "record:tui": "bash scripts/record-tui.sh",
    "install-skill": "bun run --cwd packages/terminal-control install-skill"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform": "4.0.0-beta.83",
      "@effect/platform-bun": "4.0.0-beta.83",
      "@opentui/core": "0.4.5",
      "@opentui/keymap": "0.4.5",
      "@opentui/solid": "0.4.5",
      "@tsconfig/bun": "1.0.9",
      "effect": "4.0.0-beta.83",
      "solid-js": "1.9.10",
      "typescript": "5.8.2",
      "@types/bun": "1.3.14"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "turbo": "2.9.18",
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  },
  "license": "MIT"
}
